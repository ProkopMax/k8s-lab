# GitLab configuration file
# This file is managed by Ansible

## GitLab URL
external_url '{{ gitlab_external_url }}'

## Timezone
gitlab_rails['time_zone'] = '{{ gitlab_time_zone }}'

## Backup settings
gitlab_rails['backup_keep_time'] = {{ gitlab_backup_keep_time }}

## GitLab administrator password (will be set during installation)
# gitlab_rails['initial_root_password'] = '{{ gitlab_admin_password }}'

## SSL Configuration
nginx['ssl_certificate'] = '{{ gitlab_ssl_certificate }}'
nginx['ssl_certificate_key'] = '{{ gitlab_ssl_certificate_key }}'

## Worker optimization
# Configure number of Sidekiq workers based on available CPU cores
sidekiq['concurrency'] = {{ gitlab_sidekiq_concurrency }}

# Configure number of unicorn workers
unicorn['worker_processes'] = {{ gitlab_unicorn_worker_processes }}

## Disable unnecessary services to save resources
# Disable GitLab Pages
gitlab_pages['enable'] = {{ gitlab_pages_enable | lower }}

# Disable GitLab LDAP integration (if not needed)
gitlab_rails['ldap_enabled'] = {{ gitlab_rails_ldap_enabled | lower }}

# Disable GitLab Container Registry
registry['enable'] = {{ gitlab_registry_enable | lower }}
registry_external_url '{{ gitlab_registry_external_url }}'
gitlab_rails['registry_enabled'] = {{ gitlab_registry_enable | lower }}

registry_nginx['enable'] = {{ gitlab_registry_nginx_enable | lower }}
registry_nginx['ssl_certificate'] = '{{ gitlab_registry_ssl_certificate }}'
registry_nginx['ssl_certificate_key'] = '{{ gitlab_registry_ssl_certificate_key }}'
registry_nginx['listen_port'] = {{ gitlab_registry_nginx_port }}
registry_nginx['listen_https'] = {{ gitlab_registry_nginx_https_enabled | lower }}

## Registry storage
registry['storage'] = {
  'filesystem' => {
    'rootdirectory' => '{{ gitlab_registry_storage_path }}'
  }
}

## Additional optimizations
# Enable backup compression to save disk space
gitlab_rails['backup_compression_level'] = {{ gitlab_rails_backup_compression_level }}

# Configure backup directory
gitlab_rails['backup_path'] = '{{ gitlab_rails_backup_path }}'

# Set backup timeout
gitlab_rails['backup_timeout'] = {{ gitlab_rails_backup_timeout }}

# Enable automatic database cleanup
gitlab_rails['backup_cleanup'] = {{ gitlab_rails_backup_cleanup | lower }}

# Configure log rotation
logging['logrotate_frequency'] = '{{ gitlab_logging_logrotate_frequency }}'
logging['logrotate_rotate'] = {{ gitlab_logging_logrotate_rotate }}

## Performance optimizations
# Enable Gzip compression in nginx
nginx['gzip_enabled'] = {{ gitlab_nginx_gzip_enabled | lower }}

# Keep GitLab email notifications enabled for system alerts
gitlab_rails['gitlab_email_enabled'] = {{ gitlab_rails_gitlab_email_enabled | lower }}

# Configure nginx worker processes
nginx['worker_processes'] = {{ gitlab_nginx_worker_processes }}

# Configure nginx worker connections
nginx['worker_connections'] = {{ gitlab_nginx_worker_connections }}

# Enable GitLab's built-in Prometheus metrics
gitlab_rails['prometheus_enabled'] = {{ gitlab_rails_prometheus_enabled | lower }}

# External Prometheus monitoring
{% if gitlab_monitoring_enabled %}
{% if gitlab_monitoring_exporters.node_exporter.enabled %}
node_exporter['listen_address'] = '{{ gitlab_monitoring_exporters.node_exporter.listen_address }}'
{% endif %}

{% if gitlab_monitoring_exporters.gitlab_exporter.enabled %}
gitlab_exporter['listen_address'] = '{{ gitlab_monitoring_exporters.gitlab_exporter.listen_address }}'
gitlab_exporter['listen_port'] = '{{ gitlab_monitoring_exporters.gitlab_exporter.listen_port }}'
{% endif %}

{% if gitlab_monitoring_exporters.postgres_exporter.enabled %}
postgres_exporter['listen_address'] = '{{ gitlab_monitoring_exporters.postgres_exporter.listen_address }}'
{% endif %}

{% if gitlab_monitoring_exporters.redis_exporter.enabled %}
redis_exporter['listen_address'] = '{{ gitlab_monitoring_exporters.redis_exporter.listen_address }}'
{% endif %}

{% if gitlab_monitoring_exporters.gitlab_workhorse.enabled %}
gitlab_workhorse['prometheus_listen_addr'] = '{{ gitlab_monitoring_exporters.gitlab_workhorse.prometheus_listen_addr }}'
{% endif %}

{% if gitlab_monitoring_exporters.gitaly.enabled %}
gitaly['configuration'] ||= {}
gitaly['configuration']['prometheus_listen_addr'] = '{{ gitlab_monitoring_exporters.gitaly.prometheus_listen_addr }}'
{% endif %}
{% endif %}
