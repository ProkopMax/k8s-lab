abi <abi/3.0>,

#include <tunables/global>

profile {{ containerd_apparmor_profile_name }} flags=(attach_disconnected,mediate_deleted) {

  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Host processes may send signals to container processes.
  signal (receive) peer=unconfined,

  # runc may send signals to container processes.
  signal (receive) peer=runc,

  # crun may send signals to container processes.
  signal (receive) peer=crun,

  # containerd daemon may send signals to container processes.
  signal (receive) peer={{ containerd_apparmor_daemon_profile }},

  # Container processes may send signals amongst themselves.
  signal (send,receive) peer={{ containerd_apparmor_profile_name }},

  # Allow communication with processes using the stacked unconfined profile.
  signal (send,receive) peer={{ containerd_apparmor_profile_name }}//&unconfined,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny mount,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # Allow processes within the container to trace each other.
  ptrace (trace,tracedby,read,readby) peer={{ containerd_apparmor_profile_name }},

  # Allow ptrace with processes using the stacked unconfined profile.
  ptrace (trace,tracedby,read,readby) peer={{ containerd_apparmor_profile_name }}//&unconfined,
}